<Window x:Class="WPF_Projekt3_TaxaFirma.OperatørSkiftTaxaSide"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Projekt3_TaxaFirma"
        mc:Ignorable="d"
        Title="OperatørSkiftTaxaSide" Height="550" Width="1000">
    <Grid>
        <Rectangle HorizontalAlignment="Left" Height="356" Margin="30,140,0,0" VerticalAlignment="Top" Width="238">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F6EEF3" Offset="0"/>
                    <GradientStop Color="#E8DDEB" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle HorizontalAlignment="Left" Height="356" Margin="727,140,0,0" VerticalAlignment="Top" Width="238">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F6EEF3" Offset="0"/>
                    <GradientStop Color="#E8DDEB" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle HorizontalAlignment="Left" Height="356" Margin="286,140,0,0" VerticalAlignment="Top" Width="238">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F6EEF3" Offset="0"/>
                    <GradientStop Color="#E8DDEB" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle HorizontalAlignment="Center" Height="72" Fill="#645D68" Stroke="#645D68" VerticalAlignment="Top" Width="1000">
            <Rectangle.Effect>
                <DropShadowEffect
         BlurRadius="8"
         ShadowDepth="2"
         Opacity="0.3"/>
            </Rectangle.Effect>
        </Rectangle>
        <Image Source="Images/logo.png" HorizontalAlignment="Left" Height="54" Margin="23,9,0,0" VerticalAlignment="Top" Width="168"/>
        <Button x:Name="KnapTilbage" Content="Tilbage" HorizontalAlignment="Left" Margin="30,94,0,0" VerticalAlignment="Top" Click="KnapTilbage_Click"/>
        <ListBox x:Name="ListBoxChaufførUdenTaxa" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="308,185,498,59"/>
        <ListBox x:Name="ListBoxTaxaUdenChauffør" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="43,185,763,59"/>
        <ListBox x:Name="ListBoxChaufførerMedTaxa" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="749,185,57,59"/>
        <Button x:Name="KnapTildelTaxa" Content="Tildel" HorizontalAlignment="Left" Margin="565,236,0,0" VerticalAlignment="Top" Height="51" Width="132" Click="KnapTildelTaxa_Click"/>
        <Button x:Name="KnapFradelTaxa" Content="Fradel" HorizontalAlignment="Left" Margin="565,330,0,0" VerticalAlignment="Top" Height="51" Width="132" Click="KnapFradelTaxa_Click"/>
        <Label Content="Taxaer uden chauffører" HorizontalAlignment="Left" Margin="43,155,0,0" VerticalAlignment="Top" FontSize="16" Width="194"/>
        <Label Content="Chauffører uden taxa" HorizontalAlignment="Left" Margin="308,155,0,0" VerticalAlignment="Top" FontSize="16" Width="192"/>
        <Label Content="Chauffører med taxa" HorizontalAlignment="Left" Margin="749,155,0,0" VerticalAlignment="Top" FontSize="16" Width="194"/>

    </Grid>
</Window>
