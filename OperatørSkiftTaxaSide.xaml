<Window x:Class="WPF_Projekt3_TaxaFirma.OperatørSkiftTaxaSide"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Projekt3_TaxaFirma"
        mc:Ignorable="d"
        Title="OperatørSkiftTaxaSide" Height="550" Width="1000">
    <Grid>
        <Rectangle HorizontalAlignment="Center" Height="72" Fill="#645D68" Stroke="#645D68" VerticalAlignment="Top" Width="1000">
            <Rectangle.Effect>
                <DropShadowEffect
         BlurRadius="8"
         ShadowDepth="2"
         Opacity="0.3"/>
            </Rectangle.Effect>
        </Rectangle>
        <Image Source="Images/logo.png" HorizontalAlignment="Left" Height="54" Margin="23,9,0,0" VerticalAlignment="Top" Width="168"/>
        <Button x:Name="KnapTilbage" Content="Tilbage" HorizontalAlignment="Left" Margin="43,94,0,0" VerticalAlignment="Top" Click="KnapTilbage_Click"/>

    </Grid>
</Window>
