<Window x:Class="WPF_Projekt3_TaxaFirma.OperatørSkiftTaxaSide"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Projekt3_TaxaFirma"
        mc:Ignorable="d"
        Title="OperatørSkiftTaxaSide" Height="550" Width="1000">
    <Grid>
        <Rectangle HorizontalAlignment="Center" Height="72" Fill="#645D68" Stroke="#645D68" VerticalAlignment="Top" Width="1000">
            <Rectangle.Effect>
                <DropShadowEffect
         BlurRadius="8"
         ShadowDepth="2"
         Opacity="0.3"/>
            </Rectangle.Effect>
        </Rectangle>
        <Image Source="Images/logo.png" HorizontalAlignment="Left" Height="54" Margin="23,9,0,0" VerticalAlignment="Top" Width="168"/>
        <Button x:Name="KnapTilbage" Content="Tilbage" HorizontalAlignment="Left" Margin="43,94,0,0" VerticalAlignment="Top" Click="KnapTilbage_Click"/>
        <ListBox x:Name="ListboxTaxaUdenCH" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="308,165,498,23" SelectionChanged="ListboxTaxaUdenCH_SelectionChanged"/>
        <ListBox x:Name="ListboxChauffør" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="43,165,763,23"/>
        <ListBox x:Name="ListboxTaxaTildeltChauffør" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="749,165,57,23"/>
        <Button x:Name="KnapTildelTaxa" Content="Tildel" HorizontalAlignment="Left" Margin="565,267,0,0" VerticalAlignment="Top" Height="51" Width="132" Click="KnapTildelTaxa_Click"/>
        <Button x:Name="KnapFradelTaxa" Content="Fradel" HorizontalAlignment="Left" Margin="565,385,0,0" VerticalAlignment="Top" Height="51" Width="132" Click="KnapFradelTaxa_Click"/>
        <Label Content="Taxa uden chauffører" HorizontalAlignment="Left" Margin="48,140,0,0" VerticalAlignment="Top"/>
        <Label Content="Chauffører" HorizontalAlignment="Left" Margin="308,140,0,0" VerticalAlignment="Top"/>
        <Label Content="Taxa med chauffører" HorizontalAlignment="Left" Margin="749,140,0,0" VerticalAlignment="Top"/>

    </Grid>
</Window>
