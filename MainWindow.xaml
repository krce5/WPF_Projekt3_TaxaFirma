<Window x:Class="WPF_Projekt3_TaxaFirma.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Projekt3_TaxaFirma"
        mc:Ignorable="d"
        Title="MainWindow" Height="550" Width="800">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F6EEF3" Offset="0"/>
            <GradientStop Color="#E8DDEB" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid>
        <Button x:Name="KnapLogind" Content="Logind" HorizontalAlignment="Center" Margin="0,347,0,0" VerticalAlignment="Top" Click="Button_Click" Width="156" Height="35"/>
        <TextBox x:Name="TxtBoxBrugernavn" HorizontalAlignment="Center" Margin="0,218,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="156" Height="34"/>
        <TextBox x:Name="TxtBoxAdgangskode" HorizontalAlignment="Center" Margin="0,283,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="156" Height="30"/>
        <Label Content="Brugernavn" HorizontalAlignment="Left" Margin="322,193,0,0" VerticalAlignment="Top" Width="120"/>
        <Label Content="Adgangskode" HorizontalAlignment="Left" Margin="322,258,0,0" VerticalAlignment="Top" Width="120"/>
        <Label x:Name="LblBesked" Content="" HorizontalAlignment="Center" Margin="0,318,0,0" VerticalAlignment="Top" Width="156" Height="29" Foreground="Red" />
        <Image Source="Images/logo.png"  HorizontalAlignment="Center" Height="100" Margin="0,62,0,0" VerticalAlignment="Top" Width="270"/>

    </Grid>
</Window>
