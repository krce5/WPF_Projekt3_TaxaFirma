<Window x:Class="WPF_Projekt3_TaxaFirma.ChaufførSide"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Projekt3_TaxaFirma"
        mc:Ignorable="d"
        Title="ChaufførSide" Height="450" Width="800">
    <Grid>
        <Label Content="Din status:" HorizontalAlignment="Left" Margin="48,264,0,0" VerticalAlignment="Top" Width="71"/>
        <TextBox x:Name="TxtBoxStatus" HorizontalAlignment="Left" Margin="124,268,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <Button x:Name="KnapStartVagt" Content="Start / Afslut Vagt" HorizontalAlignment="Left" Margin="48,330,0,0" VerticalAlignment="Top" Height="36" Width="97" Click="KnapStartVagt_Click"/>
        <Button x:Name="KnapLedighed" Content="Ledig / Ikke Ledig" HorizontalAlignment="Left" Margin="209,330,0,0" VerticalAlignment="Top" Height="36" Width="115" Click="KnapLedighed_Click"/>
        <Button x:Name="KnapPause" Content="Start / Slut Pause" HorizontalAlignment="Left" Margin="378,330,0,0" VerticalAlignment="Top" Height="36" Width="116" Click="KnapPause_Click"/>
        <Label x:Name="LblVelkommen" Content="Velkommen" HorizontalAlignment="Left" Margin="33,67,0,0" VerticalAlignment="Top" Width="233"/>

    </Grid>
</Window>
