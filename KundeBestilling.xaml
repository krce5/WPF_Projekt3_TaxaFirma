<Window x:Class="WPF_Projekt3_TaxaFirma.KundeBestilling"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Projekt3_TaxaFirma"
        mc:Ignorable="d"
        Title="KundeBestilling" Height="550" Width="1000" Background="White">

    <Grid>
        <Rectangle HorizontalAlignment="Left" Height="165" Margin="23,356,0,0" VerticalAlignment="Top" Width="945">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F6EEF3" Offset="0"/>
                    <GradientStop Color="#E8DDEB" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle HorizontalAlignment="Center" Height="72" Fill="#645D68" Stroke="#645D68" VerticalAlignment="Top" Width="1000">
            <Rectangle.Effect>
                <DropShadowEffect
                        BlurRadius="8"
                        ShadowDepth="2"
                        Opacity="0.3"/>
            </Rectangle.Effect>
        </Rectangle>
        <Rectangle HorizontalAlignment="Left" Height="237" Margin="23,104,0,0" VerticalAlignment="Top" Width="945">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F6EEF3" Offset="0"/>
                    <GradientStop Color="#E8DDEB" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <TextBox x:Name="TxtBoxStedA" HorizontalAlignment="Left" Margin="65,145,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="215" Height="36"/>
        <TextBox x:Name="TxtBoxStedB" HorizontalAlignment="Left" Margin="64,191,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="215" Height="36"/>
        <Button x:Name="KnapBestil" Content="Bestil" Background="#BA55D3" Foreground="White" HorizontalAlignment="Left" Margin="812,433,0,0" VerticalAlignment="Top" Width="134" Height="40" Click="KnapBestil_Click"/>
        <Label Content="Fra" HorizontalAlignment="Left" Margin="38,155,0,0" VerticalAlignment="Top"/>
        <Label Content="Til" HorizontalAlignment="Left" Margin="40,201,0,0" VerticalAlignment="Top"/>
        <Button x:Name="KnapFindTaxa" Content="Find Taxaer" HorizontalAlignment="Left" Margin="145,241,0,0" VerticalAlignment="Top" Width="134" Height="31" Click="KnapFindTaxa_Click"/>
        <Label x:Name="LblBesked" Content="" HorizontalAlignment="Left" Margin="65,285,0,0" VerticalAlignment="Top" Width="220" Height="36"/>
        <ListBox x:Name="ListBoxLedigTaxa" Margin="314,145,324,213"/>
        <Label x:Name="LblSvar" Content="Velkommen bruger!" HorizontalAlignment="Left" Margin="25,77,0,0" VerticalAlignment="Top" Height="27" Width="354" FontSize="16"/>
        <TextBox x:Name="TxtBestillingsOversigt" HorizontalAlignment="Left" Margin="68,387,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="671" Height="115"/>
        <Button x:Name="KnapLoggeUd" Content="Logge Ud" HorizontalAlignment="Left" Margin="871,23,0,0" VerticalAlignment="Top" Click="KnapLoggeUd_Click"/>
        <Image Source="Images/logo.png" HorizontalAlignment="Left" Height="54" Margin="23,9,0,0" VerticalAlignment="Top" Width="168"/>
        <Label x:Name="LblBestilTaxa" Content="Bestil en taxa:" HorizontalAlignment="Left" Margin="65,111,0,0" VerticalAlignment="Top" Height="24" Width="256" FontSize="16"/>
        <Label x:Name="LblAlleTaxaer" Content="Alle taxaer:" HorizontalAlignment="Left" Margin="314,120,0,0" VerticalAlignment="Top" Width="160"/>
        <Label x:Name="LblAlleTaxaer_Copy" Content="Bestillings oversigt:" HorizontalAlignment="Left" Margin="68,362,0,0" VerticalAlignment="Top" Width="217" FontSize="16"/>
        <TextBox x:Name="TxtBoxPris" HorizontalAlignment="Left" Margin="726,145,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="203" Height="176"/>
        <Label x:Name="LblPrisOversigt" Content="Pris oversigt:" HorizontalAlignment="Left" Margin="726,120,0,0" VerticalAlignment="Top" Width="160"/>
    </Grid>
</Window>
